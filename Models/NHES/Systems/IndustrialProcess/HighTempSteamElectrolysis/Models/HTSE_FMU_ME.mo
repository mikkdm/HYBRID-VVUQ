#include <stdlib.h>
#include \"FMI/fmi2Import.h\"
void NHES_Systems_IndustrialProcess_HighTempSteamElectrolysis_Models_TightlyCoupled_0HTSE_0SteamFlowCtrl_0FY17_0FMU_0adaptor9290597437139065257733_fmiEnterModelInitialization2(void*m, double startTime) {
  struct dy_fmi2Extended*a=m;
  fmi2Status status=fmi2Fatal;
  fmi2Boolean toleranceControlled=fmi2False;
  fmi2Real tolerance=0;
  if (a) {
    if(a->currentMode==dyfmi2InstantiationMode){
      a->dyTime=startTime;
      status=a->dyFmiSetupExperiment(a->m, fmi2False, 0, a->dyTime, fmi2False, 0);
      status=a->dyFmiEnterInitializationMode(a->m);
      a->currentMode=dyfmi2InitializationMode;
      a->dyTriggered=0;
      a->dyLastTime=a->dyTime;
    }else{
      status=fmi2OK;
    }
  }
  if (status!=fmi2OK && status!=fmi2Warning) ModelicaError(\"Initialize failed\");
}
#endif", Library="NHES_Systems_IndustrialProcess_HighTempSteamElectrolysis_Models_TightlyCoupled_0HTSE_0SteamFlowCtrl_0FY17_0FMU_0adaptor", LibraryDirectory=
