    function fmiDeSerializeFMUstate
      input fmiModel fmi;
      external"C" NHES_Systems_IndustrialProcess_HighTempSteamElectrolysis_Models_TightlyCoupled_0HTSE_0SteamFlowCtrl_0FY17_0FMU_0adaptor9290597437139065257733_fmiDeSerializeFMUstate2(fmi)
        annotation (Include="
#ifndef NHES_Systems_IndustrialProcess_HighTempSteamElectrolysis_Models_TightlyCoupled_0HTSE_0SteamFlowCtrl_0FY17_0FMU_0adaptor9290597437139065257733_fmiDeSerializeFMUstate_C
