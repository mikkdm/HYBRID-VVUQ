    function fmiDoStep
    input fmiModel fmi;
    input Real currentTime;
    input Real stepSize;
    input Real preAvailable;
    output Boolean stepOK;
    output Real postAvailable=preAvailable;
    external"C" stepOK= NHES_Systems_IndustrialProcess_HighTempSteamElectrolysis_Models_TightlyCoupled_0HTSE_0SteamFlowCtrl_0FY17_0FMU_0adaptor47555799424262989912360_fmiDoStep2(fmi, currentTime, stepSize)
      annotation (Include="
#ifndef NHES_Systems_IndustrialProcess_HighTempSteamElectrolysis_Models_TightlyCoupled_0HTSE_0SteamFlowCtrl_0FY17_0FMU_0adaptor47555799424262989912360_DoStep_C
#define NHES_Systems_IndustrialProcess_HighTempSteamElectrolysis_Models_TightlyCoupled_0HTSE_0SteamFlowCtrl_0FY17_0FMU_0adaptor47555799424262989912360_DoStep_C 1
#include <stdlib.h>
#include \"FMI/fmi2Import.h\"
double NHES_Systems_IndustrialProcess_HighTempSteamElectrolysis_Models_TightlyCoupled_0HTSE_0SteamFlowCtrl_0FY17_0FMU_0adaptor47555799424262989912360_fmiDoStep2(void*m, double currentTime, double stepSize) {
  struct dy_fmi2Extended*a=m;
  fmi2Status status=fmi2Fatal;
  fmi2Boolean value=fmi2False;
  if (a) {
    status=a->dyFmiDoStep(a->m, currentTime, stepSize, fmi2True);
    if(status==fmi2Discard){
      status = a->dyFmiGetBooleanStatus(a->m, fmi2Terminated, &value);
      if(value==fmi2True){
        double tt = 0;
        char s[64] = {0};
        fmi2Status stat2 = fmi2Error;
        stat2 = a->dyFmiGetRealStatus(a->m, fmi2LastSuccessfulTime, &tt);
#if defined(_MSC_VER) && _MSC_VER >= 1200
        if(stat2 == fmi2OK && _snprintf(s, sizeof(s)/sizeof(*s), \"Terminate signaled by the FMU at time %g\", tt) > 0){
#else
        if(stat2 == fmi2OK && snprintf(s, sizeof(s)/sizeof(*s), \"Terminate signaled by the FMU at time %g\", tt) > 0){
#endif
			terminate(s);
        }else{
          terminate(\"Terminate signaled by the FMU\");
        }
      }
    }
  }
  if (status!=fmi2OK && status!=fmi2Warning){    ModelicaFormatError(\"The call of fmi2DoStep(%f, %f) failed in FMU\\r\\nNote: setting fmi_loggingOn in the FMU component may produce more information from the FMU.\",currentTime, stepSize);  }  return 1.0;
}
#endif", Library="NHES_Systems_IndustrialProcess_HighTempSteamElectrolysis_Models_TightlyCoupled_0HTSE_0SteamFlowCtrl_0FY17_0FMU_0adaptor", LibraryDirectory=
            "modelica://NHES/Resources/Library/FMU/NHES_Systems_IndustrialProcess_HighTempSteamElectrolysis_Models_TightlyCoupled_0HTSE_0SteamFlowCtrl_0FY17_0FMU_0adaptor/binaries");
