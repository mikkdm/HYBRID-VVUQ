          annotation (Include="
#ifndef NHES_Systems_IndustrialProcess_HighTempSteamElectrolysis_Models_TightlyCoupled_0HTSE_0SteamFlowCtrl_0FY17_0FMU_0adaptor47555799424262989912360_Free_C
#define NHES_Systems_IndustrialProcess_HighTempSteamElectrolysis_Models_TightlyCoupled_0HTSE_0SteamFlowCtrl_0FY17_0FMU_0adaptor47555799424262989912360_Free_C 1
#include \"FMI/fmi2Import.h\"
#include <stdlib.h>
void NHES_Systems_IndustrialProcess_HighTempSteamElectrolysis_Models_TightlyCoupled_0HTSE_0SteamFlowCtrl_0FY17_0FMU_0adaptor47555799424262989912360_fmiFreeModelInstance2(void*m) {
  struct dy_fmi2Extended*a=m;
  if (a) {
    if(a->dyFMUstate)
    a->dyFmiFreeFMUstate(a->m, &a->dyFMUstate);
    /*a->dyFmiSetDebugLogging(a->m,fmi2True,0,NULL);*/
    a->dyFmiTerminate(a->m);
    a->dyFmiFreeInstance(a->m);
    FreeLibrary(a->hInst);
    free(a->der);a->der=0;
    free(a->out);a->out=0;
    free(a);
  }
}
